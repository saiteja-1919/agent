[TEMPLATE]
# ============================================================================
# Veda - configuration template.
# Copy this file to ".env" and fill in your real values. The .env file is the
# only place secrets live. Never share or zip the .env file.
# ============================================================================

# ---------------------------------------------------------------- Telephony provider
# Which company places the calls: exotel or twilio. Everything below follows
# this switch.
CALL_PROVIDER=exotel

# ---------------------------------------------------------------- Exotel (used when CALL_PROVIDER=exotel)
EXOTEL_ACCOUNT_SID=your_account_sid
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
# Your ExoPhone (the number that appears on the parent's phone). A landline
# with the STD code is fine, for example 0404xxxxxxx.
EXOTEL_CALLER_ID=0XXXXXXXXXX
# Singapore accounts: https://api.exotel.com
# Mumbai accounts:    https://api.in.exotel.com
EXOTEL_API_BASE=https://api.exotel.com

# Public address of this server (used by BOTH providers - the key name is
# historical). With a Cloudflare quick tunnel it changes every time the tunnel
# restarts. Paths:
#   exotel: /v1/exotel/stream      token as query: ...?token=<same value>
#   twilio: /v1/twilio/stream      token as path:   .../v1/twilio/stream/<same value>
#   (Twilio does not accept a query string in a Stream URL.)
EXOTEL_STREAM_URL=wss://your-public-host/v1/exotel/stream

# ---------------------------------------------------------------- Twilio (used when CALL_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Your Twilio number in international form. Twilio has no Indian numbers, and
# calls to India may only be made from non-Indian numbers.
TWILIO_CALLER_ID=+15551234567
TWILIO_API_BASE=https://api.twilio.com

# ---------------------------------------------------------------- Sarvam
SARVAM_API_KEY=your_sarvam_api_key
# The realtime websocket needs "<model>-realtime"; Veda adds that itself.
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_LANGUAGE=te-IN
SARVAM_LLM_MODEL=sarvam-105b-conversations
SARVAM_TTS_MODEL=bulbul:v3

# ---------------------------------------------------------------- School (required for every call)
SCHOOL_NAME=

# ---------------------------------------------------------------- Voice and replies
SARVAM_TTS_VOICE=shubh
# 0.5 to 2.0 (1.0 = normal speed)
SARVAM_TTS_PACE=1.15
# 0.01 to 2.0 (higher = livelier, lower = flatter).
# If Sarvam rejects the value, keep it at or below 1.0.
SARVAM_TTS_TEMPERATURE=0.6
LLM_TEMPERATURE=0.6
LLM_MAX_TOKENS=300

# ---------------------------------------------------------------- Turn taking
# Silence (seconds) before the parent is considered finished. Lower = faster
# replies, but may cut people off.
VAD_STOP_SECS=0.35
VAD_START_SECS=0.2
# Lower this (for example 0.4) if quiet parents are not being heard.
VAD_MIN_VOLUME=0.6
USER_TURN_STOP_TIMEOUT_SECS=0.5
PIPECAT_HEARTBEAT_SECS=1.0

# ---------------------------------------------------------------- Safety
# Keep 127.0.0.1 when the tunnel runs on the same computer.
HOST=127.0.0.1
PORT=8000
# Hard limit for one call, and how long silence may last before the call is
# ended (0 = never). Both are enforced by the server as well as the dialer.
CALL_TIMEOUT_SECS=600
IDLE_TIMEOUT_SECS=60
# Recommended: a secret that only your own stream URL knows. Create one with:
#   python -c "import secrets; print(secrets.token_urlsafe(16))"
# then put it at the END of EXOTEL_STREAM_URL:
#   exotel: ...?token=<the same value>
#   twilio: .../v1/twilio/stream/<the same value>
STREAM_TOKEN=

# ---------------------------------------------------------------- Opener and call ending
# While the two opening lines are being spoken the parent's audio is not sent to
# speech recognition, so an early "hello" cannot cut the opener. If the opener
# never finishes (a TTS failure), the gate opens by itself after this many seconds.
OPENER_GATE=true
OPENER_GATE_MAX_SECS=12

# Convert digits to English words between the model and the voice, in case the
# model writes "5000" instead of "five thousand". Safe to keep on.
DIGIT_FILTER=true

# Veda ends the call herself after her final goodbye (the model marks it with
# HANGUP_MARKER). Turn off if a call ever ends too early.
AGENT_HANGUP=true
HANGUP_MARKER=[END]
# How long to wait (seconds) after the last spoken word before hanging up, so the
# final audio is not cut off.
HANGUP_GRACE_SECS=0.8

# Pre-render the two opening lines with Sarvam before the phone is dialled, so
# the first word comes out sooner. Off by default: it is unverified whether
# plain output audio frames play through the Exotel serializer. When on, any
# failure falls back to the normal live opener.
OPENER_PRERENDER=false
